# --- Google Cloud Vision (OCR) --- REQUIRED for the label upload flow ---
# Base64 of a GCP service-account JSON key that has the "Cloud Vision API User" role.
#   base64 -i service-account.json
GOOGLE_CLOUD_CREDENTIALS=base64-encoded-service-account-json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# --- Supabase --- only needed for the "add product" / "search products" pages ---
# The label upload / OCR flow works without these.
# Project URL and keys from: Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key is server-only (used by /api/products). Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
