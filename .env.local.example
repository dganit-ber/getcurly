# --- Supabase ---
# Project URL and keys from: Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key is server-only (used by the API route handlers for Storage upload + inserts).
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Name of the public Storage bucket that holds uploaded label images (see supabase/migrations).
SUPABASE_LABELS_BUCKET=labels

# --- Google Cloud Vision (OCR) ---
# Base64 of a GCP service-account JSON key that has the "Cloud Vision API User" role.
#   cat service-account.json | base64
GOOGLE_CLOUD_CREDENTIALS=base64-encoded-service-account-json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
